{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Lumen Setup",
	"version": "../app-frontend/package.json",
	"mainBinaryName": "Lumen Setup",
	"identifier": "pl.lumen.setup",
	"build": {
		"beforeDevCommand": "pnpm --filter @lumen/installer-frontend dev",
		"beforeBuildCommand": "pnpm --filter @lumen/installer-frontend build",
		"frontendDist": "../installer-frontend/dist",
		"devUrl": "http://localhost:1421"
	},
	"bundle": {
		"active": true,
		"targets": [],
		"icon": ["../app/icons/128x128.png", "../app/icons/128x128@2x.png", "../app/icons/icon.icns", "../app/icons/icon.ico"],
		"resources": ["resources/payload/app.zip"]
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Lumen Setup",
				"label": "main",
				"width": 720,
				"height": 520,
				"minWidth": 720,
				"minHeight": 520,
				"resizable": false,
				"fullscreen": false,
				"decorations": false,
				"center": true,
				"visible": true
			}
		],
		"security": {
			"capabilities": ["default"],
			"csp": null
		}
	}
}
