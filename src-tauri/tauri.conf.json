{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octra Launcher",
  "version": "1.0.0",
  "identifier": "pl.octra.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Octra Launcher",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' asset: https://asset.localhost http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [],
    "shortDescription": "Octra Launcher \u2014 experimental Minecraft launcher",
    "longDescription": "Eksperymentalny launcher Minecraft (dev). Osobny od Lumena.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRjBEQUIxQjBFMkJBNTAKUldSUXV1S3dzZHJ3aXdXc3E3MTZvMDZEUEduTDFWTWJtWlFaa0IrN3oyaUY3cnFsTW1IRnh3eW8K",
      "endpoints": [
        "https://github.com/VasstOFC/octra-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
